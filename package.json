{
  "name": "check-this-link",
  "version": "0.1.1",
  "private": true,
  "description": "A local-first Firefox extension that flags suspicious link patterns.",
  "scripts": {
    "build": "web-ext build --source-dir extension --artifacts-dir artifacts --overwrite-dest",
    "lint": "web-ext lint --source-dir extension",
    "start": "web-ext run --source-dir extension",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "web-ext": "10.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
